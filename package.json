{
	"name": "browser-sqlite",
	"version": "1.0.0-rc.4",
	"description": "Browser SQLite with concurrent read / serial write isolation, backed by Web Workers and wa-sqlite",
	"author": "LAlex",
	"license": "MIT",
	"sideEffects": [
		"./dist/worker/worker.js"
	],
	"engines": {
		"node": ">=18"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/lalexdotcom/browser-sqlite.git"
	},
	"bugs": {
		"url": "https://github.com/lalexdotcom/browser-sqlite/issues"
	},
	"homepage": "https://github.com/lalexdotcom/browser-sqlite#readme",
	"keywords": [
		"sqlite",
		"browser",
		"web-worker",
		"opfs",
		"wa-sqlite",
		"wasm",
		"shared-array-buffer"
	],
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./worker": "./dist/worker/worker.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"NOTICE"
	],
	"scripts": {
		"build": "rslib build",
		"check": "biome check --write",
		"lint": "biome lint",
		"dev": "rslib build --watch",
		"format": "biome format --write",
		"prepare": "simple-git-hooks",
		"test": "rstest && rstest --config rstest.firefox.config.ts",
		"test:watch": "rstest --watch",
		"test:unit": "rstest --project unit",
		"test:browser": "rstest --project chromium && rstest --config rstest.firefox.config.ts",
		"test:chromium": "rstest --project chromium",
		"test:firefox": "rstest --config rstest.firefox.config.ts",
		"test:consumer": "node scripts/consumer-smoke.mjs",
		"test:conformance": "rstest --config rstest.conformance.config.ts && rstest --config rstest.conformance.firefox.config.ts",
		"test:conformance:chromium": "rstest --config rstest.conformance.config.ts",
		"test:conformance:firefox": "rstest --config rstest.conformance.firefox.config.ts",
		"docs:vfs": "node scripts/render-vfs-matrix.ts",
		"bench:build": "pnpm build && node scripts/bench/assemble.mjs _site",
		"bench:serve": "npx --yes kill-port 8099 && pnpm bench:build && node scripts/static-server.mjs _site 8099",
		"bench:dev": "npx --yes kill-port 8099 && node scripts/bench/dev.mjs 8099"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.8",
		"@mdn/browser-compat-data": "^8.0.13",
		"@rslib/core": "^0.23.2",
		"@rstest/adapter-rslib": "0.11.8",
		"@rstest/browser": "0.11.8",
		"@rstest/core": "0.11.8",
		"@types/node": "^24.12.0",
		"lint-staged": "^16.4.0",
		"playwright": "1.62.1",
		"simple-git-hooks": "^2.13.1",
		"typescript": "^7.0.2",
		"wa-sqlite": "github:rhashimoto/wa-sqlite#v1.1.2"
	},
	"lint-staged": {
		"*.{js,ts,jsx,tsx,mjs,cjs}": [
			"biome check --write --no-errors-on-unmatched"
		]
	},
	"simple-git-hooks": {
		"pre-commit": "npx lint-staged && pnpm test && pnpm exec tsc --noEmit"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"simple-git-hooks"
		],
		"patchedDependencies": {
			"wa-sqlite@1.1.1": "patches/wa-sqlite@1.1.1.patch"
		}
	},
	"private": false,
	"packageManager": "pnpm@10.31.0"
}
