# Local
.DS_Store
*.local
*.log*
.claude/settings.local.json

# Dist
node_modules
dist/
storybook-static
_site/
doc_build/

# IDE
.vscode/*
!.vscode/extensions.json
.idea

# Benchmark exports collected from real devices. They describe one machine on
# one day; only their conformance half is ever worth citing, and that gets
# quoted into the README with its source rather than committed here.
.bench/

# PNPM
.pnpm-store
# Subagent-driven-development scratch: ledgers, briefs, reports, review packages.
.superpowers/

# Scratch clones for upstream work (forks, patches under review). Never shipped.
.work/

# Raw reports from `pnpm test:matrix`, one run per timestamped directory.
.matrix/

# Every run that goes through scripts/bounded.mjs (`pnpm test` and the hooks),
# the newest 30 kept, so a failure seen once can be read after a green rerun.
.test-runs/

# Probes, fixtures and throwaway harnesses. In the project so they are visible
# in the editor, ignored so they never ship. Never referenced by src/ or by CI.
.scratchpad/

# MemPalace per-project files (issue #185)
mempalace.yaml
entities.json
