{
  "compilerOptions": {
    "lib": ["ES2024", "DOM"],
    "module": "ESNext",
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": true,
    // The Vitest tests import the library by name; tests/vitest.config.ts aliases
    // them to tests/build/ (`browser-sqlite` through tests/browser/helpers/
    // library.ts, which imports `browser-sqlite/built`), and the types come from
    // the sources they build: tests/build/ does not exist before a test run.
    "paths": {
      "browser-sqlite": ["./src/index.ts"],
      "browser-sqlite/built": ["./src/index.ts"],
      "browser-sqlite/testing": ["./tests/harness/testing.ts"]
    }
  },
  "include": ["src", "tests", "scripts", "rslib.config.ts"],
  // Consumer fixtures are standalone apps: they resolve `browser-sqlite` and
  // their bundler from their own install, not from this package's node_modules.
  // Excluded as one folder, so adding a fixture cannot redden `tsc --noEmit`
  // for a resolution that is correct where it runs.
  // `tests/build/` is the rslib output the suite loads (gitignored): its .d.ts
  // would enter the program locally but not on a fresh clone.
  "exclude": ["tests/consumers", "tests/build"]
}
